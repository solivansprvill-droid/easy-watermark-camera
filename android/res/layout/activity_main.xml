<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 网格线 -->
    <com.victory.easywatermark.GridOverlay
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <!-- 定时倒计时 -->
    <TextView
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="72sp"
        android:textStyle="bold"
        android:shadowColor="#AA000000"
        android:shadowRadius="8"
        android:visibility="gone"/>

    <!-- 马克风格水印预览卡 -->
    <LinearLayout
        android:id="@+id/wm_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="140dp"
        android:background="@drawable/wm_card_bg"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wm_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/wm_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical"
                android:textColor="#F2FFFFFF"
                android:textSize="14sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/wm_addr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="300dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/wm_geo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/wm_verify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F2FFFFFF"
            android:textSize="12sp"
            android:text="🛡 水印相机已验证照片真实性"/>
    </LinearLayout>

    <!-- 顶栏：设置 / 切换前后摄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="#73000000"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/app_name"
            android:scaleType="center"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/btn_allp"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:gravity="center"
            android:background="@drawable/wm_card_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="10dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:text="全部照片"/>

        <ImageButton
            android:id="@+id/btn_switch"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="#73000000"
            android:src="@drawable/ic_flip"
            android:contentDescription="@string/app_name"
            android:scaleType="center"/>
    </LinearLayout>

    <!-- 辅助行：闪光 / 定时 / 网格 / 历史 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="80dp"
        android:layout_marginStart="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_flash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wm_card_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="10dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="⚡关"/>

        <TextView
            android:id="@+id/btn_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wm_card_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="10dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="⏱关"/>

        <TextView
            android:id="@+id/btn_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wm_card_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="10dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="▦网格"/>

        <TextView
            android:id="@+id/btn_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wm_card_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="10dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="🕘历史"/>

        <TextView
            android:id="@+id/btn_loc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wm_card_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="📍选址"/>
    </LinearLayout>

    <!-- 底栏：相册 / 快门 / 历史 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/btn_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="28dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:shadowColor="#AA000000"
            android:shadowRadius="6"
            android:text="🖼️\n相册"/>

        <ImageButton
            android:id="@+id/btn_shutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/shutter_bg"
            android:contentDescription="@string/app_name"/>
    </FrameLayout>
</FrameLayout>
